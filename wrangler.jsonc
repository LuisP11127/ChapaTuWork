{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chapatuwork",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chapatuwork",
      "database_id": "310a7094-56f2-4db6-be70-a90adca2d06f",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
